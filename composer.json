{
    "name": "phpsoftbox/mdx",
    "description": "MDX document metadata and Vite/Inertia integration for PhpSoftBox",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.4",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpsoftbox/cli-app": "dev-master",
        "phpsoftbox/cs-fixer": "^1.1.0",
        "phpunit/phpunit": "^11.2"
    },
    "suggest": {
        "phpsoftbox/inertia": "Use the Inertia adapter payload with PhpSoftBox Inertia pages.",
        "phpsoftbox/vite": "Serve and build React MDX modules through the PhpSoftBox Vite adapter."
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Mdx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Mdx\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
